[Unit]
Description=NetLiveness Phishing training server (Node.js)
After=network-online.target

[Service]
Type=simple
User=netliveness
Group=netliveness
WorkingDirectory=/opt/netliveness/phishing
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
Environment=PORT=3001

[Install]
WantedBy=multi-user.target
